# Code Sleuth's model key, for --polish. Copy this file to Code Sleuth's own folder, never into a repository:
#   macOS    ~/Library/Application Support/code-sleuth/.env
#   Linux    $XDG_DATA_HOME/code-sleuth/.env, else ~/.local/share/code-sleuth/.env
#   Windows  %LOCALAPPDATA%\code-sleuth\.env
# then make it yours alone (chmod 600 on macOS and Linux) and fill in the key. A key already set in your
# environment wins over this file, and Code Sleuth reads no other .env.
ANTHROPIC_API_KEY=
